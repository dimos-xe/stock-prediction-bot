name: US Stock Prediction

on:
  schedule:
    # 21:30 UTC = 23:30 Ώρα Ελλάδος
    - cron: '30 21 * * 1-5'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v2
    
    - name: Set up Python
      uses: actions/setup-python@v2
      with:
        python-version: '3.9'
        
    - name: Install dependencies
      run: |
        pip install -r requirements.txt
        
    - name: Run US Prediction Model
      env:
        TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
        TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      # ΕΔΩ: Του λέμε να τρέξει με την παράμετρο US
      run: python main.py US
      
    - name: Commit and Push History
      run: |
        git config --global user.name "StockBot"
        git config --global user.email "bot@example.com"
        git add history.csv
        git commit -m "📈 Update US prediction history [skip ci]" || exit 0
        git push
